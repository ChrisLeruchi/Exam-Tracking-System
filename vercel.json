{
  "buildCommand": "npm run build --prefix exam-tamper-frontend",
  "outputDirectory": "exam-tamper-frontend/dist",
  "installCommand": "npm install --prefix exam-tamper-frontend",
  "build": {
    "env": {
      "VITE_API_URL": "@vite-api-url"
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
